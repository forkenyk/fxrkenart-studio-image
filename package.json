{
  "name": "fxrkenart-studio-image",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:api": "node --watch --import tsx server/index.ts",
    "build": "tsc --noEmit && npm run typecheck:worker && vite build",
    "typecheck:worker": "tsc --noEmit -p tsconfig.worker.json",
    "deploy": "npm run build && npx wrangler deploy",
    "preview": "vite preview",
    "start:api": "node --import tsx server/index.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "hono": "^4.9.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}

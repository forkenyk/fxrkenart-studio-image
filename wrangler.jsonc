{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fxrkenart-studio-image",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-04",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }


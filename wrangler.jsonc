{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fxrkenart-studio-image",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-04",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "fxrkenart-studio-image",
    "database_id": "b173c0cd-5c54-47cd-a3e7-dbbad7bc9d44"
  }],
  "r2_buckets": [{
    "binding": "MEDIA",
    "bucket_name": "fxrkenart-studio-image-media"
  }]
}

API_PORT=4175
STARTING_CREDITS=36
SQLITE_PATH=./data/studio.sqlite
MEDIA_DIR=./data/media

# Provider credentials stay on the Hono server. Never put them in VITE_* variables.
HF_API_BASE_URL=https://api.higgsfield.ai
HF_CREDENTIALS=KEY_ID:KEY_SECRET
HF_SOUL_TEXT_PATH=/higgsfield-ai/soul/standard
HF_SOUL_IMAGE_PATH=/higgsfield-ai/soul/v2/image-to-image
# Set the exact Nano Banana PRO route from the provider account you use.
HF_NANO_BANANA_PATH=

API_PORT=4175
STARTING_CREDITS=36
SQLITE_PATH=./data/studio.sqlite
MEDIA_DIR=./data/media

# Local development uses /. Override this at production build time with
# /studio-image/.
VITE_BASE_PATH=/

# Provider credentials stay on the Hono server. Never put them in VITE_* variables.
HF_API_BASE_URL=https://api.higgsfield.ai
HF_CREDENTIALS=KEY_ID:KEY_SECRET
HF_SOUL_TEXT_PATH=/higgsfield-ai/soul/standard
HF_SOUL_IMAGE_PATH=/higgsfield-ai/soul/v2/image-to-image
# Set the exact Nano Banana PRO route from the provider account you use.
HF_NANO_BANANA_PATH=

# Google OAuth (server-side only; never expose the secret in VITE_* variables).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Example for the standalone Worker/API: https://your-host/api/auth/google/callback
GOOGLE_REDIRECT_URI=
# Where the OAuth callback returns after a successful login.
GOOGLE_APP_URL=
